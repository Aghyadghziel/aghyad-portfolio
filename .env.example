# Public origin of the deployed site. Used for canonical URLs, Open Graph tags,
# the sitemap and structured data. Without it the build falls back to the Vercel
# deployment URL, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Only needed if you add entries to `protectedRoutes` in src/resources/once-ui.config.ts.
PAGE_ACCESS_PASSWORD=

# --- Admin panel + analytics ---------------------------------------------
# Neon Postgres connection string (free tier). Get it at https://neon.com →
# your project → Connect → "Connection string" (pooled). Required for /admin.
DATABASE_URL=

# 32+ random characters. Signs login codes and hashes visitor ids.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Resend API key for the login codes and contact messages.
# Get it at https://resend.com → API Keys. Without it, /admin login codes are
# only printed to the dev server console and never delivered.
RESEND_API_KEY=

# Verified sender in Resend, e.g. "Aghyad Admin <admin@your-domain.com>".
# With no verified domain, use onboarding@resend.dev.
AUTH_FROM=
CONTACT_FROM=
